{
  "name": "signbridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SignBridge - two-way sign language bridge (Phase 1: expressive fingerspelling avatar)",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "check:signs": "node scripts/validate-signs.mjs",
    "check:render": "tsx scripts/ssr-smoke.tsx",
    "check": "npm run typecheck && npm run check:signs && npm run check:render",
    "render:avatar": "tsx scripts/render-avatar.tsx"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
